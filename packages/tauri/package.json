{
  "name": "@openchamber/tauri",
  "version": "1.22.2",
  "private": true,
  "description": "Tauri 2 native shell for OpenChamber",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.conf.json",
