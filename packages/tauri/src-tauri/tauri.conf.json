{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChamber",
  "version": "1.22.2",
  "identifier": "dev.openchamber.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenChamber",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http://127.0.0.1:* http://localhost:*; frame-src 'self' openchamber-ui: http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agentic Development Environment for OpenCode",
    "longDescription": "OpenChamber is a Tauri-native shell for OpenCode. Run, review, and ship agent work from one window.",
    "publisher": "OpenChamber",
    "resources": {
      "./resources/opencode-cli/*": "opencode-cli"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements/macos.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Denizwsa/openped/releases/latest/download/{{target}}/{{arch}}/{{app_filename}}.tar.gz"
      ],
      "pubkey": ""
    }
  }
}